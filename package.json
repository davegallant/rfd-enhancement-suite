{
  "devDependencies": {
    "jsdom": "^31.0.0",
    "playwright": "^1.63.0",
    "web-ext": "^10.8.0"
  },
  "scripts": {
    "test": "node --test 'test/unit/*.test.js'",
    "build:userscript": "node scripts/build-userscript.mjs",
    "start:firefox": "web-ext run --source-dir .",
    "build": "web-ext build --overwrite-dest --source-dir .",
    "lint": "web-ext lint --source-dir .",
    "sign": "web-ext sign --source-dir .",
    "test:browser": "playwright test"
  }
}
